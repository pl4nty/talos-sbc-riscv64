+			"bootaon ${aon_addr_r} ${filesize}; " \
+		"fi; " \
 		"if load mmc 0:1 ${fdt_addr_r} dtb/${fdtfile}; then " \
 			"bootefi bootmgr ${fdt_addr_r}; " \
 		"fi; bootefi bootmgr\0"
