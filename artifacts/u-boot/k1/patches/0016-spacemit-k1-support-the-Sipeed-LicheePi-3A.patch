From 6b563831b9d82288b7547400cb3a2bebacd7f4c0 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 6 Oct 2026 07:57:48 +0000
Subject: [PATCH 16/17] spacemit: k1: support the Sipeed LicheePi 3A

The Lichee Module 3A is the K1 reference design: SpacemiT's own
k1-x_lpi3a.dts matches k1-x_deb1.dts (the BPI-F3) apart from an SD clock
delay. Boot it with the BPI-F3 FIT configuration.

Also set fdtfile from the control DT's compatible, so the EFI loader hands
the OS its own copy of the board DT from dtb/${fdtfile} on the ESP.
---
 board/spacemit/k1/board.c | 39 +++++++++++++++++++++++++++++++++++++++
 board/spacemit/k1/spl.c   |  6 ++++++
 2 files changed, 45 insertions(+)

diff --git a/board/spacemit/k1/board.c b/board/spacemit/k1/board.c
index ea416621..f89db5b8 100644
--- a/board/spacemit/k1/board.c
+++ b/board/spacemit/k1/board.c
@@ -3,3 +3,42 @@
  * Copyright (c) 2024, Kongyang Liu <seashell11234455@gmail.com>
  */
 
+#include <env.h>
+#include <linux/kernel.h>
+#include <asm/global_data.h>
+#include <fdt_support.h>
+
+#ifndef CONFIG_SPL_BUILD
+DECLARE_GLOBAL_DATA_PTR;
+
+static const struct {
+	const char *compatible;
+	const char *fdtfile;
+} k1_fdtfile_map[] = {
+	{ "bananapi,bpi-f3",      "spacemit/k1-bananapi-f3.dtb"   },
+	{ "milkv,jupiter",        "spacemit/k1-milkv-jupiter.dtb" },
+	{ "spacemit,musepi-pro",  "spacemit/k1-musepi-pro.dtb"    },
+};
+
+/*
+ * Point the EFI loader at the OS's copy of the board DT (dtb/${fdtfile} on
+ * the ESP), so the kernel gets a DT that matches it rather than U-Boot's.
+ */
+int board_late_init(void)
+{
+	int i;
+
+	if (env_get("fdtfile"))
+		return 0;
+
+	for (i = 0; i < ARRAY_SIZE(k1_fdtfile_map); i++) {
+		if (!fdt_node_check_compatible(gd->fdt_blob, 0,
+					       k1_fdtfile_map[i].compatible)) {
+			env_set("fdtfile", k1_fdtfile_map[i].fdtfile);
+			break;
+		}
+	}
+
+	return 0;
+}
+#endif
diff --git a/board/spacemit/k1/spl.c b/board/spacemit/k1/spl.c
index ef23db62..73d49826 100644
--- a/board/spacemit/k1/spl.c
+++ b/board/spacemit/k1/spl.c
@@ -148,6 +148,12 @@ static const struct {
 	{ "k1-x_MUSE-Pi-Pro",   "spacemit/k1-musepi-pro"    },
 	{ "k1-x_deb1",          "spacemit/k1-bananapi-f3"   },
 	{ "k1-x_milkv-jupiter", "spacemit/k1-milkv-jupiter" },
+	/*
+	 * The Lichee Module 3A is the K1 reference design: SpacemiT's own
+	 * k1-x_lpi3a.dts matches k1-x_deb1.dts apart from an SD clock delay.
+	 */
+	{ "k1-x_lpi3a",         "spacemit/k1-bananapi-f3"   },
+	{ "k1_lpi3a",           "spacemit/k1-bananapi-f3"   },
 };
 
 int read_product_name(char *name, int size)
-- 
