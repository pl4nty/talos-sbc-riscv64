From e6d0ebaae8d0551fa836a78c052218e15fd0f48f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 7 Oct 2026 02:49:53 +0000
Subject: [PATCH] spacemit: k1: fall back to other boot devices in SPL

The boot flag register keeps its value across a warm reset, so after a
vendor kernel reboots, SPL can pick SPI on a board that boots from eMMC
and stop with no U-Boot found. Try the detected device first, then eMMC,
SD and SPI.
---
 board/spacemit/k1/spl.c | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/board/spacemit/k1/spl.c b/board/spacemit/k1/spl.c
index 0c66a3c0..c21dcfed 100644
--- a/board/spacemit/k1/spl.c
+++ b/board/spacemit/k1/spl.c
@@ -504,6 +504,25 @@ u32 spl_boot_device(void)
 	return ret;
 }
 
+/*
+ * The boot flag register keeps its value across a warm reset, so a stale
+ * value from a previous boot (for example, a vendor kernel's reboot) can
+ * point at a device that holds no U-Boot. Try the detected device first,
+ * then the other boot devices.
+ */
+void board_boot_order(u32 *spl_boot_list)
+{
+	static const u32 fallback[] = {
+		BOOT_DEVICE_MMC1, BOOT_DEVICE_MMC2, BOOT_DEVICE_SPI,
+	};
+	int i, n = 0;
+
+	spl_boot_list[n++] = spl_boot_device();
+	for (i = 0; i < ARRAY_SIZE(fallback); i++)
+		if (fallback[i] != spl_boot_list[0])
+			spl_boot_list[n++] = fallback[i];
+}
+
 void spl_board_init(void)
 {
 }
