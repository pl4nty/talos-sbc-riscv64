 #include <sbi_utils/fdt/fdt_helper.h>
 
 struct thead_generic_quirks {
 	u64	errata;
+	bool	th1520_reset;
+};
+
+/*
+ * TH1520 global software reset, in the AON reset generator. This is the
+ * sequence the vendor U-Boot uses; it doesn't need the AON firmware.
+ */
+#define TH1520_AON_RSTGEN		0xfffff44000UL
+#define TH1520_SYS_RST_CFG		(TH1520_AON_RSTGEN + 0x10)
+#define TH1520_SW_SYS_RST_REQ		BIT(0)
+#define TH1520_RST_REQ_EN_0		(TH1520_AON_RSTGEN + 0x140)
+#define TH1520_SW_GLB_RST_EN		BIT(0)
+
+static int th1520_system_reset_check(u32 type, u32 reason)
+{
+	switch (type) {
+	case SBI_SRST_RESET_TYPE_COLD_REBOOT:
+	case SBI_SRST_RESET_TYPE_WARM_REBOOT:
+		return 1;
+	}
+
+	return 0;
+}
+
+static void th1520_system_reset(u32 type, u32 reason)
+{
+	void *en = (void *)TH1520_RST_REQ_EN_0;
+
+	writel(readl(en) | TH1520_SW_GLB_RST_EN, en);
+	writel(TH1520_SW_SYS_RST_REQ, (void *)TH1520_SYS_RST_CFG);
+}
+
+static struct sbi_system_reset_device th1520_reset = {
+	.name			= "th1520-aon-rstgen",
+	.system_reset_check	= th1520_system_reset_check,
+	.system_reset		= th1520_system_reset,
 };
 
 static int thead_tlb_flush_early_init(bool cold_boot)
@@ -26,6 +65,14 @@ static int thead_tlb_flush_early_init(bool cold_boot)
 	return generic_early_init(cold_boot);
 }
 
+static int th1520_early_init(bool cold_boot)
+{
+	if (cold_boot)
+		sbi_system_reset_add_device(&th1520_reset);
+
+	return thead_tlb_flush_early_init(cold_boot);
+}
